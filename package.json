{
  "name": "codex-remote-console",
  "version": "1.5.0",
  "description": "Desktop app for remote Codex CLI sessions over SSH with project history, folder picker, chat UI, and packaged builds for macOS, Windows, and Linux.",
  "desktopName": "Codex Remote",
  "author": "rub1kub",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "NODE_ENV=production node build/server/index.js",
    "typecheck": "tsc --noEmit",
    "test:task-protocol": "tsx scripts/test-task-protocol.ts",
    "test:model-catalog": "tsx scripts/test-model-catalog.ts",
    "test:message-history": "tsx scripts/test-message-history.ts",
    "test:ui": "npm run build && node scripts/test-ui.mjs",
    "test:project-tools": "npm run build:server && node scripts/test-project-tools.mjs",
    "test:shell": "npm run build:server && node scripts/test-shell-commands.mjs",
    "smoke:ssh": "npm run build && node scripts/smoke-ssh.mjs",
    "qa:release": "node scripts/release-qa.mjs --assets",
    "build:server": "tsc -p tsconfig.server.json && node scripts/mark-server-commonjs.cjs",
    "build": "npm run typecheck && vite build && npm run build:server",
    "electron:dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "express": "^4.19.2",
    "lucide-react": "^1.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.61.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.1.3"
  },
  "build": {
    "appId": "com.rub1kub.codexremote",
    "productName": "Codex Remote",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/server/**/*",
      "build/icon.png",
      "electron/**/*",
      "package.json",
      "!node_modules/cpu-features/**/*",
      "!node_modules/nan/**/*",
      "!node_modules/ssh2/lib/protocol/crypto/build/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "artifactName": "Codex-Remote-${version}-mac-${arch}.${ext}",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "artifactName": "Codex-Remote-${version}-win-${arch}.${ext}",
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Development",
      "artifactName": "Codex-Remote-${version}-linux-${arch}.${ext}",
      "icon": "build/icon.png",
      "maintainer": "rub1kub <rub1kub@users.noreply.github.com>",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
